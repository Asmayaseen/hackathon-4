# PostgreSQL (Neon serverless)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/course_companion?sslmode=require

# Cloudflare R2
# For local development, set R2_ACCOUNT_ID=local to skip R2 entirely (content served from DB)
R2_ACCOUNT_ID=local
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
R2_BUCKET_NAME=course-companion-content

# App
APP_VERSION=1.0.0
ENVIRONMENT=development
# Upgrade URL shown to free users hitting premium content
UPGRADE_URL=https://course-companion.fly.dev/upgrade

# Phase 2 — Hybrid Intelligence (Claude Sonnet)
# Leave empty or unset to run in MOCK/DEMO mode (realistic demo responses, no real LLM calls)
# Set to your Anthropic API key to enable real Claude AI responses for Pro users
ANTHROPIC_API_KEY=
