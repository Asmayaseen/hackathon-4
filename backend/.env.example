# PostgreSQL (Neon serverless)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/course_companion?sslmode=require

# Cloudflare R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=course-companion-content

# App
APP_VERSION=1.0.0
ENVIRONMENT=development
# Upgrade URL shown to free users hitting premium content
UPGRADE_URL=https://course-companion.fly.dev/upgrade
